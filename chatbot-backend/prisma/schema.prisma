generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  phone     String?   @unique
  role      UserRole  @default(CLIENT)
  planType  PlanTypes @default(FREE)
  companies Company[]
  userPlan  UserPlan?

  @@map("users")
}

model UserPlan {
  id        String    @id @default(uuid())
  userId    String    @unique
  planId    String
  planType  PlanTypes
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  plan      Plan      @relation(fields: [planId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_plans")
}

model Company {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  whatsappNumber     String?
  ownerId            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  analytics          Analytics[]
  assistants         Assistant[]
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversationCaches ConversationCache[]
  conversations      Conversation[]
  knowledgeBases     KnowledgeBase[]
  knowledgeChunks    KnowledgeChunk[]
  messageLogs        MessageLog[]
  messages           Message[]
  products           Product[]
  services           Service[]
  subscriptions      Subscription[]
  trainingData       TrainingData[]

  @@map("companies")
}

model Assistant {
  id             String   @id @default(uuid())
  companyId      String
  name           String
  description    String?
  whatsappNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("assistants")
}

model Product {
  id          String         @id @default(uuid())
  name        String
  description String?
  price       Float?
  category    MacroCategory  @default(OUTROS)
  companyId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("products")
}

model Service {
  id          String         @id @default(uuid())
  name        String
  description String?
  price       Float?
  category    MacroCategory
  companyId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("services")
}

model Message {
  id        String      @id @default(uuid())
  from      MessageFrom
  content   String
  companyId String
  createdAt DateTime    @default(now())
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model TrainingData {
  id        String   @id @default(uuid())
  companyId String
  data      Json
  trainedAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("training_data")
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  price         Float
  limitMessages Int
  createdAt     DateTime       @default(now())
  benefits      String[]       @default([])
  planType      PlanTypes      @unique
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  userPlans     UserPlan[]

  @@map("plans")
}

model Analytics {
  id                  String   @id @default(uuid())
  companyId           String
  date                DateTime @default(now())
  totalMessages       Int      @default(0)
  clientMessages      Int      @default(0)
  botMessages         Int      @default(0)
  responseRate        Float?
  averageResponseTime Float?
  automaticResponses  Int      @default(0)
  manualResponses     Int      @default(0)
  hourlyDistribution  Json?
  topKeywords         Json?
  dailyVolume         Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("analytics")
}

model Subscription {
  id        String             @id @default(uuid())
  companyId String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model KnowledgeBase {
  id        String            @id @default(uuid())
  companyId String
  title     String
  category  KnowledgeCategory
  content   String
  metadata  Json?
  isActive  Boolean           @default(true)
  priority  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]

  @@index([companyId, isActive])
  @@index([companyId, category])
  @@map("knowledge_bases")
}

model KnowledgeChunk {
  id              String        @id @default(uuid())
  knowledgeBaseId String
  companyId       String
  content         String
  embedding       Json?
  chunkIndex      Int
  tokenCount      Int?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contentHash     String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([companyId, knowledgeBaseId])
  @@index([knowledgeBaseId, chunkIndex])
  @@map("knowledge_chunks")
}

model Conversation {
  id          String              @id @default(uuid())
  companyId   String
  clientPhone String?
  clientName  String?
  sessionId   String?
  status      ConversationStatus  @default(ACTIVE)
  startedAt   DateTime            @default(now())
  endedAt     DateTime?
  metadata    Json?
  caches      ConversationCache[]
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messageLogs MessageLog[]

  @@index([companyId, status])
  @@index([companyId, startedAt])
  @@index([clientPhone])
  @@map("conversations")
}

model ConversationCache {
  id              String        @id @default(uuid())
  companyId       String
  conversationId  String?
  queryEmbedding  Json?
  queryText       String?
  response        String?
  cacheType       CacheType
  memoryType      MemoryType?
  key             String?
  value           String?
  confidence      Float         @default(1.0)
  similarityScore Float?
  source          CacheSource
  context         Json?
  isActive        Boolean       @default(true)
  hitCount        Int           @default(0)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id])

  @@index([companyId, cacheType, isActive])
  @@index([companyId, source])
  @@index([companyId, expiresAt])
  @@index([conversationId])
  @@index([queryText])
  @@index([key])
  @@map("conversation_caches")
}

model MessageLog {
  id             String             @id @default(uuid())
  companyId      String
  conversationId String?
  from           MessageFrom
  content        String
  contentType    MessageContentType @default(TEXT)
  metadata       Json?
  processingTime Float?
  aiModel        String?
  aiTokens       Int?
  aiCost         Float?
  source         MessageSource
  createdAt      DateTime           @default(now())
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   Conversation?      @relation(fields: [conversationId], references: [id])

  @@index([companyId, createdAt])
  @@index([conversationId, createdAt])
  @@index([companyId, from])
  @@index([source])
  @@map("message_logs")
}

enum MessageFrom {
  CLIENT
  BOT
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum UserRole {
  ADMIN
  CLIENT
}

enum PlanTypes {
  FREE
  BASIC
  PRO
}

enum KnowledgeCategory {
  PRODUCT
  SERVICE
  POLICY
  FAQ
  COMPANY_INFO
  CUSTOM
}

enum CacheType {
  CACHE
  MEMORY
  HYBRID
}

enum CacheSource {
  RAG
  MEMORY
  AI
  HYBRID
}

enum ConversationStatus {
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum MemoryType {
  PREFERENCE
  CONTEXT
  FACT
  PATTERN
  INTENT
}

enum MemorySource {
  CONVERSATION
  MANUAL
  AI_INFERRED
  SYSTEM
}

enum MessageContentType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
}

enum MessageSource {
  WHATSAPP
  WEB_CHAT
  API
  TEST
  SYSTEM
}

enum MacroCategory {
  TECNOLOGIA
  SAUDE_E_BEM_ESTAR
  EDUCACAO
  CONSULTORIA_E_SERVICOS_PROFISSIONAIS
  COMERCIO_E_VAREJO
  INDUSTRIA_E_PRODUCAO
  SERVICOS_OPERACIONAIS
  FINANCEIRO
  IMOBILIARIO
  OUTROS
}
